{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noospheric",
  "version": "0.1.0",
  "identifier": "ai.2389.noospheric",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Noospheric Orrery",
        "width": 1280,
        "height": 840
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "resources": {
      "resources": "resources"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDIxMzU0N0U4OEZDRjE4RkQKUldUOUdNK1A2RWMxSWRzcFJEOFRUYjl6QmQ5SDBzY3dna0JOWkFTd0s1N1RLV3hqdjFvMFJrVjUK",
      "endpoints": [
        "https://github.com/2389-research/Noospheric-Orrery/releases/latest/download/latest.json"
      ]
    }
  }
}
