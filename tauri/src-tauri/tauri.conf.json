{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Noospheric",
  "version": "0.1.0",
  "identifier": "ai.2389.noospheric",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Noospheric Orrery",
        "width": 1280,
        "height": 840
      }
    ],
    "security": {
      "csp": null,
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "resources": "resources"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
