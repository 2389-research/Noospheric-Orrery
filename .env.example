# === LLM Backend ===
# Choose one: bedrock, gateway, ollama
ANTHROPIC_BACKEND=bedrock

# --- Option A: AWS Bedrock ---
AWS_ACCESS_KEY=your-aws-access-key
AWS_REGION=us-east-1
AWS_SECRET_KEY=your-aws-secret-key
CLASSIFICATION_MODEL=claude-sonnet-4-6
EXTRACTION_MODEL=claude-haiku-4-5

# --- Option B: Anthropic API (gateway) ---
# ANTHROPIC_BACKEND=gateway
# GATEWAY_URL=https://api.anthropic.com
# GATEWAY_API_KEY=sk-ant-your-key-here
# CLASSIFICATION_MODEL=claude-sonnet-4-6
# EXTRACTION_MODEL=claude-haiku-4-5

# --- Option C: Ollama (fully local, no API keys) ---
# Install Ollama, then: ollama pull gemma4:26b && ollama pull gemma4:e4b
# ANTHROPIC_BACKEND=ollama
# OLLAMA_URL=http://host.docker.internal:11434
# CLASSIFICATION_MODEL=gemma4:26b
# EXTRACTION_MODEL=gemma4:e4b

# === Data paths ===
# Docker Compose mounts ./data/ automatically. These match that mount.
DB_PATH=/data/orrery.db
DOCUMENTS_DIR=/data/documents
SPECS_DIR=/data/specs

# === Simmering thresholds ===
GENERAL_SPEC_THRESHOLD=10
DOMAIN_SPEC_THRESHOLD=20
SIMMER_ITERATIONS=3

# === Chunking ===
CHUNK_SIZE=2000

# === Worker ===
WORKER_POLL_INTERVAL=5
