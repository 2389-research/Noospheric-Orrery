# === AWS Bedrock (required for LLM calls) ===
AWS_ACCESS_KEY=your-aws-access-key
AWS_SECRET_KEY=your-aws-secret-key
AWS_REGION=us-east-1

# Model IDs (Bedrock cross-region inference profiles)
CLASSIFICATION_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0
EXTRACTION_MODEL=us.anthropic.claude-haiku-4-5-20251001-v1:0

# === Database backend ===
# sqlite  — local file-based, zero setup (default)
# firestore — Google Cloud Firestore (see Firebase section below)
DB_BACKEND=sqlite

# === SQLite paths (default mode) ===
# Docker Compose mounts ./data/ automatically. These match that mount.
DB_PATH=/data/orrery.db
DOCUMENTS_DIR=/data/documents
SPECS_DIR=/data/specs

# === Authentication ===
AUTH_REQUIRED=false

# === Simmering thresholds ===
GENERAL_SPEC_THRESHOLD=10
DOMAIN_SPEC_THRESHOLD=20
SIMMER_ITERATIONS=5

# === Chunking ===
CHUNK_SIZE=2000

# === Worker ===
WORKER_POLL_INTERVAL=5

# ─────────────────────────────────────────────────────────────
# Firebase / Firestore mode (optional)
#
# To use Firestore instead of SQLite:
#   1. Set DB_BACKEND=firestore above
#   2. Uncomment the variables below
#   3. Run: docker compose -f docker-compose.firebase.yml up
# ─────────────────────────────────────────────────────────────
# FIREBASE_PROJECT_ID=noospheric-orrery
# FIREBASE_WORKSPACE_ID=default
# VERTEX_AI_REGION=us-central1
# For production, set GOOGLE_APPLICATION_CREDENTIALS to service account key path.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account-key.json
