# LLM Backend — "gateway" (Bedrock Gateway proxy) or "bedrock" (direct AWS)
ANTHROPIC_BACKEND=gateway
GATEWAY_URL=https://bedrock-gateway.2389-research-inc.workers.dev
GATEWAY_API_KEY=your-gateway-token

# AWS Bedrock credentials (only needed when ANTHROPIC_BACKEND=bedrock)
# AWS_ACCESS_KEY=your-aws-access-key
# AWS_SECRET_KEY=your-aws-secret-key
# AWS_REGION=us-east-1

# Model names (friendly names — relay translates to Bedrock IDs when needed)
CLASSIFICATION_MODEL=claude-sonnet-4-6
EXTRACTION_MODEL=claude-haiku-4-5

# Data paths (Docker uses /data; local dev defaults to $XDG_DATA_HOME/orrery i.e. ~/.local/share/orrery)
DB_PATH=/data/orrery.db
DOCUMENTS_DIR=/data/documents
SPECS_DIR=/data/specs

# Simmering thresholds
GENERAL_SPEC_THRESHOLD=10
DOMAIN_SPEC_THRESHOLD=20
SIMMER_ITERATIONS=5

# Chunking
CHUNK_SIZE=2000

# Worker
WORKER_POLL_INTERVAL=5
