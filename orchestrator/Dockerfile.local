FROM python:3.13-slim
WORKDIR /app

# Disable numba JIT — prevents SIGILL on ARM Docker
ENV NUMBA_DISABLE_JIT=1

# Install orrery-relay
COPY packages/orrery-relay/ /tmp/orrery-relay/
RUN pip install --no-cache-dir /tmp/orrery-relay/ && rm -rf /tmp/orrery-relay/

# Install torch CPU-only from PyTorch index (no CUDA, ~200MB not 5GB)
RUN pip install --no-cache-dir torch --extra-index-url https://download.pytorch.org/whl/cpu

# Install orchestrator with local deps (sentence-transformers, FAISS, UMAP)
COPY orchestrator/pyproject.toml .
RUN pip install --no-cache-dir '.[local]'
COPY orchestrator/src/ src/
EXPOSE 8000
CMD ["uvicorn", "src.main:app", "--host", "0.0.0.0", "--port", "8000"]
